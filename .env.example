# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────────────────
# Local dev: a plain mongod connection string. Production: MongoDB Atlas
# (required if SEARCH_PROVIDER=atlas below, since Atlas Search is Atlas-only).
MONGODB_URI=mongodb://127.0.0.1:27017/glyphora

# ── Auth (Auth.js / next-auth v4) ───────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# OAuth (optional — architecture is OAuth-ready; leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Object storage (S3-compatible: AWS S3 or Cloudflare R2) ────────
# "local" (default) needs no credentials — files are read/written under
# public/uploads/ (previews) and .local-storage/ (deliverables), signed URLs are
# simulated by src/app/api/local-storage/**. Set to "s3" once you have real
# AWS S3 / Cloudflare R2 bucket credentials.
STORAGE_PROVIDER=local
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_PREVIEWS=glyphora-previews
STORAGE_BUCKET_DELIVERABLES=glyphora-deliverables
# Public base URL the preview bucket is served from (CDN or bucket public endpoint)
STORAGE_PUBLIC_BASE_URL=

# ── Payments (Stripe) ────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Search ────────────────────────────────────────────────────────────
# "local" (default, works with plain mongod) or "atlas" (requires MongoDB Atlas
# and the fonts_search index — see scripts/setup-atlas-search.ts)
SEARCH_PROVIDER=local

# ── Email (transactional — order receipts, guest download links) ───
EMAIL_PROVIDER=console
EMAIL_FROM="Glyphora <no-reply@glyphora.app>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Marketplace defaults (also editable at runtime via /admin/settings) ─
DEFAULT_COMMISSION_PERCENTAGE=30
DEFAULT_CURRENCY=USD
